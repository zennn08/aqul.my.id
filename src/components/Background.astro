---
import { education, organizations } from "../data/experience";
---

<section id="background" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="font-display text-4xl sm:text-5xl">Pendidikan &amp; Organisasi</h2>
  <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1.4fr]">
    <div class="brutal self-start bg-blue-soft p-6">
      <h3 class="font-display text-2xl">Pendidikan</h3>
      <ul class="mt-6 space-y-6">
        {
          education.map((e) => (
            <li>
              <p class="font-mono text-sm">{e.period}</p>
              <p class="mt-1 text-lg font-bold">{e.school}</p>
              <p>{e.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="grid gap-8">
      {
        organizations.map((o) => (
          <article class="brutal min-w-0 bg-paper p-6">
            <p class="font-mono text-sm">{o.period}</p>
            <h3 class="mt-1 font-display text-xl break-words">{o.role}</h3>
            <p class="mt-1 font-bold text-blue">{o.org}</p>
            <ul class="mt-3 list-[square] space-y-1.5 pl-5 marker:text-blue">
              {o.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
