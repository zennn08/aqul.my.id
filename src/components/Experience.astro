---
import { work } from "../data/experience";
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="font-display text-4xl sm:text-5xl">Experience</h2>
  <ol class="mt-10 border-l-3 border-ink">
    {
      work.map((w) => (
        <li class="relative pb-10 pl-8 last:pb-0 md:grid md:grid-cols-[11rem_1fr] md:gap-8">
          <span class="absolute top-1.5 -left-[9px] size-4 border-3 border-ink bg-blue" aria-hidden="true" />
          <p class="font-mono text-sm">{w.period}</p>
          <div class="mt-2 min-w-0 md:mt-0">
            <h3 class="font-display text-xl break-words sm:text-2xl">{w.role}</h3>
            <p class="mt-1 font-bold text-blue">{w.org}</p>
            <ul class="mt-3 max-w-[65ch] list-[square] space-y-1.5 pl-5 marker:text-blue">
              {w.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
