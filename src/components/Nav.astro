---
const links = [
  { href: "/#experience", label: "Experience" },
  { href: "/#projects", label: "Projects" },
  { href: "/#skills", label: "Skills" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="sticky top-4 z-50 mx-auto max-w-6xl px-4">
  <nav class="brutal flex items-center justify-between bg-blue px-4 py-3 text-white" aria-label="Navigasi utama">
    <a href="/" class="font-display text-lg focus-visible:outline-white">aqul.my.id</a>
    <ul class="hidden gap-6 font-bold md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="decoration-2 underline-offset-4 hover:underline focus-visible:outline-white">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    {/* ponytail: native <details>, stays open after tapping a link; add a tiny script if that bothers anyone */}
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none font-bold focus-visible:outline-white [&::-webkit-details-marker]:hidden">
        Menu
      </summary>
      <ul class="brutal absolute right-0 mt-5 w-44 bg-paper p-2 text-ink">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="block px-3 py-2 font-bold hover:bg-blue-soft">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
