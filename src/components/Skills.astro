---
import { skillGroups } from "../data/skills";
---

<section id="skills" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="font-display text-4xl sm:text-5xl">Skills</h2>
  <div class="mt-10 space-y-8">
    {
      skillGroups.map((g) => (
        <div class="grid gap-4 md:grid-cols-[11rem_1fr] md:gap-8">
          <h3 class="font-display text-xl md:pt-2">{g.title}</h3>
          <ul class="flex flex-wrap gap-3">
            {g.skills.map((s) => (
              <li class="flex items-center gap-2 border-3 border-ink bg-paper px-3 py-2 shadow-[3px_3px_0_0_var(--color-ink)]">
                <img src={s.icon} alt="" width="24" height="24" loading="lazy" class="size-6 object-contain" />
                <span class="font-mono text-sm">{s.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
